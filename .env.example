# ===========================================
# Local Development Environment Variables
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000
SHARED_DATA_DIR=./shared-data
MCP_SERVER_URL=http://localhost:9000

# ===========================================
# AI Director - Deepgram Configuration
# (Speaker diarization and enhanced transcription)
# ===========================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ===========================================
# AI Director - LiveKit Configuration
# (Multi-track recording for interviews)
# ===========================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ===========================================
# AI Director - AWS Configuration
# (S3 storage and Remotion Lambda rendering)
# ===========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_BUCKET_NAME=ai-director-videos
REMOTION_SERVE_URL=https://your-bucket.s3.amazonaws.com/remotion-bundle/

# ===========================================
# AI Director - Database Configuration
# (For production - replace JSON state management)
# ===========================================
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_director

# ===========================================
# AI Director - Task Queue Configuration
# (For async job processing)
# ===========================================
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===========================================
# Production Deployment Variables
# (used by docker-compose.deployed.yml)
# ===========================================
IMAGE_PREFIX=your_github_username
IMAGE_TAG=latest

# ===========================================
# Required GitHub Secrets for CI/CD
# Configure in: Settings > Secrets and variables > Actions
# ===========================================
# DEPLOY_HOST       - VM IP address or hostname
# DEPLOY_USER       - SSH username on VM
# DEPLOY_SSH_KEY    - Private SSH key for authentication
# OPENAI_API_KEY    - OpenAI API key for backend/mcp-server
# DEEPGRAM_API_KEY  - Deepgram API key for diarization
#
# Optional (only for private repos/packages):
# PAT               - GitHub Personal Access Token
#                     Not needed if repo is public and packages inherit visibility
