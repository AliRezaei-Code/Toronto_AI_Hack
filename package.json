{
  "name": "toronto-ai-hack",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered video editor with autonomous repurposing capabilities",
  "repository": {
    "type": "git",
    "url": "https://github.com/AliRezaei-Code/Toronto_AI_Hack.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.27",
      "@types/react-dom": "^18.3.7"
    }
  }
}
