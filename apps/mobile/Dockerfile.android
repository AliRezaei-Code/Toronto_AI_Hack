# Dockerfile for building Expo/React Native Android APK
# Usage:
#   docker build -f Dockerfile.android -t expo-android-builder .
#   docker run --rm -v $(pwd)/output:/output expo-android-builder
#
# The APK will be copied to ./output/ on your host machine

FROM node:20-bookworm

# Set environment variables
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/34.0.0

# Install system dependencies
RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    wget \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Install Android SDK
RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    cd $ANDROID_HOME/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdline-tools.zip && \
    unzip -q cmdline-tools.zip && \
    rm cmdline-tools.zip && \
    mv cmdline-tools latest

# Accept licenses and install required SDK components
RUN yes | sdkmanager --licenses && \
    sdkmanager "platform-tools" \
    "platforms;android-35" \
    "build-tools;35.0.0" \
    "build-tools;34.0.0" \
    "ndk;27.1.12297006"

# Set NDK path
ENV ANDROID_NDK_HOME=$ANDROID_HOME/ndk/27.1.12297006

# Create app directory
WORKDIR /app

# Copy package files first for better caching
COPY package.json ./
COPY ../../package.json /monorepo-root/package.json 2>/dev/null || true
COPY ../../yarn.lock /monorepo-root/yarn.lock 2>/dev/null || true
COPY ../../pnpm-lock.yaml /monorepo-root/pnpm-lock.yaml 2>/dev/null || true

# Install pnpm (since this appears to be a monorepo)
RUN npm install -g pnpm

# Copy all source files
COPY . .

# Install dependencies
RUN pnpm install --shamefully-hoist || npm install

# Generate native android project if not present
RUN npx expo prebuild --platform android --clean || true

# Create local.properties for Android SDK path
RUN echo "sdk.dir=$ANDROID_HOME" > android/local.properties && \
    echo "ndk.dir=$ANDROID_NDK_HOME" >> android/local.properties

# Build the release APK
RUN cd android && \
    chmod +x gradlew && \
    ./gradlew assembleRelease --no-daemon --stacktrace

# Create output directory and copy APK
RUN mkdir -p /output

# Entry point: copy APK to mounted volume
CMD cp android/app/build/outputs/apk/release/*.apk /output/ 2>/dev/null && \
    echo "APK copied to /output/" && \
    ls -la /output/ || \
    (echo "Release APK not found, checking debug..." && \
    cp android/app/build/outputs/apk/debug/*.apk /output/ 2>/dev/null && \
    echo "Debug APK copied to /output/" && \
    ls -la /output/)
